# =============================================
# Configuracao do Bot Discord RAG
# Copie este arquivo para .env e preencha os valores
# =============================================

# Discord
DISCORD_TOKEN=seu_token_aqui
COMMAND_PREFIX=!
BOT_NAME=Assistente
# IDs Discord autorizados a revisar/publicar correcoes globais, separados por virgula
GLOBAL_FEEDBACK_REVIEWER_IDS=

# Geracao de respostas: gemini ou openai
GENERATION_PROVIDER=gemini
GENERATION_API_KEY=sua_chave_de_geracao_aqui
GENERATION_MODEL=gemini-2.5-pro
# primary usa GENERATION_MODEL; contextual seleciona explicitamente o modelo contextual
GENERATION_MODEL_POLICY=primary
# Usado somente por providers compativeis com OpenAI
GENERATION_BASE_URL=https://api.openai.com/v1
REFORMULATION_MODEL=gemini-2.5-flash
OPENAI_REFORMULATION_MODEL=gpt-5.4-mini
OPENAI_CONTEXTUAL_MODEL=gpt-5.4-mini

# Embeddings sao independentes da geracao, mesmo quando usam a mesma conta/chave
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=sua_chave_de_embeddings_aqui
EMBEDDING_MODEL=gemini-embedding-001
# Usado somente por providers compativeis com OpenAI
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Esta versao suporta somente o perfil vetorial de 1536 dimensoes
EMBEDDING_DIMENSIONS=1536
# Altere somente quando o preprocessamento dos textos mudar de forma controlada
EMBEDDING_PREPROCESSING_VERSION=rag-text-v1
EMBEDDING_BATCH_SIZE=10
INGEST_DB_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=8
EMBEDDING_RETRY_BASE_SECONDS=5
EMBEDDING_RETRY_MAX_SECONDS=65
EMBEDDING_MIN_INTERVAL_SECONDS=0.5
EMBEDDING_RETRY_JITTER_SECONDS=0.5

# PostgreSQL
# Valores apenas para desenvolvimento local. Troque a senha em cada implantacao.
POSTGRES_DB=bot_maxima
POSTGRES_USER=bot_maxima
POSTGRES_PASSWORD=troque_esta_senha_local
# Publicacao local para ferramentas no host; os containers usam postgres:5432.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bot_maxima:troque_esta_senha_local@postgres:5432/bot_maxima
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_APPLICATION_NAME=bot-maxima

# RAG
CHUNK_SIZE=1200
CHUNK_OVERLAP=300
MAX_CONTEXT_CHUNKS=24
# Orçamento explícito do prompt; não é inferido pelo nome do modelo.
RAG_MAX_INPUT_TOKENS=24000
RAG_MAX_HISTORY_TOKENS=4000
RAG_MODEL_CONTEXT_TOKENS=65536
RAG_CONTEXT_MARGIN_TOKENS=512
RAG_IMAGE_TOKEN_RESERVE=1024
SIMILARITY_THRESHOLD=0.40
RAG_ENABLE_INTENT_ROUTING=true
RAG_FILTER_BY_DOC_TYPE=true
RAG_FILTER_BY_MODULE=true
RAG_ENABLE_GLOBAL_CHALLENGER=true
RAG_GLOBAL_CHALLENGER_COUNT=4
RAG_GLOBAL_CHALLENGER_FETCH_LIMIT=16
RAG_ENABLE_BUSINESS_RULES=true
ANALYTICAL_CONTEXT_ENABLED=true
BUSINESS_RULES_FILE=./bootstrap/00-DOCUMENTO-PRINCIPAL.md
BUSINESS_RULES_MAX_CHARS=80000
FULL_CONTEXT_ENABLED=false
RAG_ENABLE_QUERY_REFORMULATION=true
RAG_ENABLE_RERANKING=true
RERANKER_MODEL=gemini-2.5-flash
RERANKER_MAX_CANDIDATES=40
RERANKER_MIN_TRIGGER_SIM=0.55
RERANKER_MAX_TRIGGER_SIM=0.82
SECTION_RETRIEVAL_ENABLED=true
SECTION_MATCH_COUNT=12
SECTION_FETCH_LIMIT=48
CHUNK_FETCH_LIMIT=80
MAX_CHUNKS_PER_SECTION=3
MAX_CHUNKS_PER_DOCUMENT=6
RAG_STRICT_ABSTAIN=true
RAG_MIN_STRONG_SIMILARITY=0.42
RAG_MIN_RETRIEVED_CHUNKS=2
RAG_OPERATIONAL_SIMILARITY_MARGIN=0.03
RAG_ENABLE_GROUNDING_VALIDATION=true
RAG_REQUIRE_SOURCES_SECTION=true
RAG_MAX_REGEN_ATTEMPTS=2
RAG_PROVIDER_MAX_RETRIES=2
RAG_RETRY_BASE_SECONDS=1
RAG_FEEDBACK_TOP_K=4
RAG_FEEDBACK_MIN_SIMILARITY=0.58
ABSTAIN_CLARIFYING_QUESTION=Pode detalhar o modulo, a tela/parametro e a mensagem de erro exata para eu buscar com mais precisao?

# Bot â€” limites
COOLDOWN_SECONDS=10
ASK_TIMEOUT_SECONDS=240
ASK_MAX_CONCURRENCY=4
ASK_MAX_TOKENS=16384
OPENAI_MAX_OUTPUT_TOKENS=16384
MAX_HISTORY_PAIRS=12
MAX_HISTORY_CHANNELS=100

# Documentos
DOCS_DIR=./documentos
FAILED_INGEST_REPORT=./ingest_failures.json
# Percorre subdiretorios. Diretorios de backup continuam excluidos pela lista abaixo.
INGEST_RECURSIVE=false
# Nomes de diretorios ignorados (case-insensitive), separados por virgula. Vazio inclui backups.
INGEST_EXCLUDED_DIRS=docbkp,backup,backups,bkp

# Ingestao web (URLs)
WEB_FETCH_TIMEOUT_SECONDS=20
WEB_USER_AGENT=BotMaximaRAG/1.0
# Limites aplicados a cada download, inclusive APIs auxiliares e redirects.
WEB_MAX_REDIRECTS=5
WEB_MAX_DOWNLOAD_BYTES=10485760
# Hosts exatos ou curingas *.exemplo.com, separados por virgula. Vazio aceita hosts publicos.
WEB_ALLOWED_HOSTS=
WEB_MAX_TEXT_CHARS=400000
URLS_FILE_DEFAULT=./documentos/urls.txt
URL_REVIEW_OUTPUT_DIR=./documentos/_pendentes_url

# Contextual Retrieval por LLM (opt-in; o benchmark da issue #16 manteve o contexto deterministico)
CONTEXTUAL_RETRIEVAL_ENABLED=false
CONTEXTUAL_RETRIEVAL_MODEL=gemini-2.5-flash
CONTEXTUAL_RETRIEVAL_MAX_DOC_CHARS=500000
CONTEXTUAL_RETRIEVAL_MAX_TOKENS=250
CONTEXTUAL_RETRIEVAL_BATCH_SIZE=20

# Revisao manual (_pendentes_url)
REVIEW_INCLUDE_RAW_TEXT=true
REVIEW_RAW_TEXT_MAX_CHARS=120000
